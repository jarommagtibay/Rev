# Copy this file to .env and fill it in. NEVER commit .env (it is already in .gitignore).

# ---- Required: the bot will not start without these ----
TOKEN=
CLIENT_ID=
GUILD_ID=
STAFF_ROLE_ID=

# ---- Channels and roles (leave a line empty to turn that feature off) ----
# Category where ticket channels are created
CATEGORY_ID=
# Channel where /buy posts the Buy panel
BUY_CHANNEL_ID=
# Where customer vouches are posted
VOUCH_CHANNEL_ID=
# Where a receipt is posted when an order is completed
RECEIPT_CHANNEL_ID=
# Where /shop posts the open / closed picture
SHOP_STATUS_CHANNEL_ID=
# Role pinged for shop open / closed and stock announcements
SHOP_PING_ROLE_ID=
# Where the stock board is posted every hour
STOCK_CHANNEL_ID=
# PRIVATE staff channel: ticket log + transcripts (make it staff-only!)
AUDIT_CHANNEL_ID=

# ---- Payment details shown with each payee's QR (see PAYEES in config.js) ----
# One line per payee: PAYMENT_<KEY IN CAPITALS>
PAYMENT_HIXSLY=
PAYMENT_YSHA=
